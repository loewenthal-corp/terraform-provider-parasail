{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":ignoreUnstable"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Examples reference this provider itself; never bump it from Renovate",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["provider"],
      "enabled": false
    },
    {
      "description": "Hermit-managed tools (Go, Terraform, OpenTofu, linters, scanners) land together and merge on green CI",
      "matchDatasources": ["hermit"],
      "groupName": "hermit tools",
      "automerge": true
    },
    {
      "description": "GitHub runner images merge on green CI",
      "matchDatasources": ["github-runners"],
      "automerge": true
    },
    {
      "description": "GitHub Actions pin bumps merge on green CI",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "stale.yaml is Tofu-managed; pin bumps belong in the infrastructure template",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/stale.yaml"],
      "enabled": false
    },
    {
      "description": "The Terraform plugin libraries are released together and depend on each other",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/hashicorp/terraform-plugin-**"],
      "groupName": "terraform plugin libraries"
    },
    {
      "description": "Renovate skips indirect Go modules by default; batch them into one weekly PR",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true,
      "groupName": "indirect go modules",
      "schedule": ["before 8am on monday"],
      "automerge": true
    },
    {
      "description": "Minor and patch Go module bumps merge on green CI",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Keep the go directive in go.mod as the declared minimum; hermit pins the toolchain",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "prConcurrentLimit": 3,
  "prHourlyLimit": 6,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["before 8am"],
    "prConcurrentLimit": 3
  }
}
